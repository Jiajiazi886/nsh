# Site binding is configured in Baota Nginx, not in the frontend build.
SITE_PUBLIC_URL=http://www.xn--kbrr2vyxjytebq4azkrrie.icu/

# Copy these operational values into deploy/prod.env after running New-ProductionEnv.ps1.
APP_NAME=Nsh Guild Console
APP_VERSION=1.9.0
APP_WORKERS=1
APP_SAME_TIME_LOGIN=true
APP_DEMO_MODE=false

# Baota MySQL 8 connection. The host value is the Docker-to-host gateway.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ruoyi-fastapi
MYSQL_USERNAME=nsh_app
MYSQL_PASSWORD=replace_with_the_baota_database_user_password
DOCKER_NETWORK_SUBNET=172.28.0.0/16

# OpenAI-compatible visual model connection. These take effect after recreating the backend container.
# Keep MIMO_API_KEY empty: set it after deployment from System Management -> AIKey Management.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_TIMEOUT_SECONDS=60
MIMO_MAX_COMPLETION_TOKENS=2048
