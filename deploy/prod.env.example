# Copy this file to deploy/prod.env on the server, then replace every CHANGE_ME value.

FRONTEND_PORT=12580
APP_IMAGE_TAG=CHANGE_ME_assigned_by_prepare_script

# The public domain is bound in Baota Nginx. The frontend uses the relative /docker-api path,
# so no frontend rebuild is required when only the public domain changes.
APP_NAME=Nsh Guild Console
APP_VERSION=1.9.0

# Baota MySQL 8 runs on the server host, not in Docker.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ruoyi-fastapi
MYSQL_USERNAME=nsh_app
MYSQL_PASSWORD=CHANGE_ME_mysql_application_password
DOCKER_NETWORK_SUBNET=172.28.0.0/16

REDIS_PASSWORD=CHANGE_ME_redis_password

JWT_SECRET_KEY=CHANGE_ME_64_hex_or_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REDIS_EXPIRE_MINUTES=30

APP_WORKERS=1
APP_SAME_TIME_LOGIN=true
APP_DEMO_MODE=false
APP_TRUSTED_PROXY_IPS=127.0.0.1,::1
APP_TRUSTED_PROXY_HOPS=1

LOGURU_LEVEL=INFO
LOGURU_STDOUT=true
LOG_FILE_ENABLED=true
LOG_INSTANCE_ID=prod
LOG_SERVICE_NAME=ruoyi-fastapi-backend

# Keep the key empty in this file and configure it after deployment through
# System Management -> AIKey Management. The runtime key is encrypted in MySQL.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_TIMEOUT_SECONDS=60
MIMO_MAX_COMPLETION_TOKENS=2048

# Generate production secrets with .\deploy\New-ProductionEnv.ps1.
TRANSPORT_CRYPTO_ENABLED=true
TRANSPORT_CRYPTO_MODE=optional
TRANSPORT_CRYPTO_KID=prod-1
TRANSPORT_CRYPTO_RSA_KEY_SIZE=4096
TRANSPORT_CRYPTO_PUBLIC_KEY=CHANGE_ME_generated_public_key
TRANSPORT_CRYPTO_PRIVATE_KEY=CHANGE_ME_generated_private_key
