ARG BASE_IMAGE=python:3.10
FROM ${BASE_IMAGE}

ARG BUILD_REVISION=unknown
ARG BUILD_DATE=unknown
ARG PIP_INDEX_URL=https://pypi.org/simple
LABEL org.opencontainers.image.revision=$BUILD_REVISION \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.source="https://github.com/Jiajiazi886/nsh"

RUN rm -rf /app && mkdir -p /app
WORKDIR /app

# 复制源代码
COPY . .

# 安装依赖。默认使用官方 PyPI；离线/内网构建可通过 PIP_INDEX_URL 覆盖。
RUN pip install --no-cache-dir -r requirements.txt --index-url "${PIP_INDEX_URL}"

# 暴露端口
EXPOSE 9099

# 启动命令
CMD ["ruoyi", "app", "run", "--env=dockermy"]
