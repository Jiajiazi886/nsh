.profile-form{background:#fff;border:1rpx solid #dce0e6;padding:20rpx;margin:16rpx 0;color:#253044;font-size:26rpx;border-radius:6rpx}.heading{font-size:30rpx;font-weight:600;margin-bottom:10rpx}.hint{color:#687386;font-size:23rpx;line-height:1.6;margin:8rpx 0}.field{display:flex;align-items:center;gap:12rpx;margin:18rpx 0}.label{flex:0 0 130rpx}.field input,.field textarea{flex:1;min-width:0;padding:12rpx;border:1rpx solid #dce0e6;border-radius:4rpx;background:#fff;font-size:26rpx}.field textarea{height:130rpx}.field button{margin:0;font-size:24rpx;line-height:36rpx;padding:3rpx 12rpx;border:1rpx solid #dce0e6}.buttons{display:flex;gap:12rpx;flex-wrap:wrap}.buttons button{margin:0;background:#edf3fc;color:#245db2}.error{background:#fff1ef;color:#a32626;padding:14rpx}.options{border:1rpx solid #dce0e6;background:#f8f9fb;padding:14rpx}.options button{display:inline-block;margin:6rpx;font-size:24rpx;line-height:36rpx;padding:3rpx 12rpx}.profile-form button::after{border:0}
