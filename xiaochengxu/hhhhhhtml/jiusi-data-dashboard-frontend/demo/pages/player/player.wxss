.player-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #7c5cff, #4e8cff);
}

.player-name {
  font-size: 36rpx;
  font-weight: 800;
}

.team-chip { margin-top: 12rpx; }

.stat-row {
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #1c2432;
}

.stat-row:last-child { border-bottom: none; }

.stat-row-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.stat-row-val {
  font-size: 27rpx;
  font-weight: 700;
}
