.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 40rpx;
  color: #fff;
  background: linear-gradient(135deg, #7c5cff, #4e8cff);
}

.hero-title {
  font-size: 32rpx;
  font-weight: 800;
}

.offline-chip {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #7be0c3;
  border: 1rpx solid rgba(32, 201, 151, 0.45);
  background: rgba(32, 201, 151, 0.1);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.group-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

@media (max-width: 360px) {
  .group-grid { grid-template-columns: repeat(2, 1fr); }
}

.group-card {
  background: #121722;
  border: 1rpx solid #283142;
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
}

.group-name {
  font-size: 25rpx;
  font-weight: 700;
}

.group-count { margin-top: 4rpx; }

.group-stat {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 14rpx;
  gap: 8rpx;
}

.group-stat .v {
  font-size: 23rpx;
  font-weight: 700;
  color: #d9d1ff;
}

.cmp-block {
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #1c2432;
}

.cmp-block:last-child { border-bottom: none; }

.cmp-title {
  font-size: 24rpx;
  color: #cdd6ea;
  margin-bottom: 12rpx;
}

.cmp-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.cmp-row:last-child { margin-bottom: 0; }

.cmp-group {
  width: 130rpx;
  font-size: 21rpx;
  color: #8f9bb3;
  flex-shrink: 0;
}

.cmp-bar { flex: 1; margin-top: 0; }

.cmp-val {
  width: 150rpx;
  text-align: right;
  font-size: 21rpx;
  color: #eef2ff;
  flex-shrink: 0;
}

.metric-scroll { width: 100%; white-space: nowrap; }

.tag-tabs.nowrap {
  flex-wrap: nowrap;
  display: inline-flex;
  margin-bottom: 0;
}

.link-btn {
  color: #a994ff;
}
