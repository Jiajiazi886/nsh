.input {
  background: #0e131d;
  border: 1rpx solid #283142;
  border-radius: 14rpx;
  color: #fff;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
}

.group-cap { margin: 16rpx 4rpx 10rpx; }

.pick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.pick-card {
  background: #171e2b;
  border: 2rpx solid #283142;
  border-radius: 14rpx;
  padding: 14rpx 12rpx;
  text-align: center;
}

.pick-card.on {
  border-color: #7c5cff;
  background: #1b1830;
}

.pick-card.on .pick-name { color: #d9d1ff; }

.pick-name { font-size: 25rpx; font-weight: 600; }

.pick-card.slim {
  font-size: 23rpx;
  padding: 12rpx 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.career-tree {
  margin-top: 16rpx;
  max-height: 560rpx;
  overflow-y: auto;
  border: 1rpx solid #283142;
  border-radius: 14rpx;
  background: #0e131d;
}

.career-node + .career-node {
  border-top: 1rpx solid #232b3a;
}

.career-folder {
  min-height: 82rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #151c28;
}

.career-folder.open {
  background: #181d2c;
}

.career-folder:active {
  background: #211c38;
}

.career-folder-copy {
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.career-folder-name {
  color: #f1efff;
  font-size: 27rpx;
  font-weight: 700;
}

.career-folder-count {
  margin-left: 14rpx;
  color: #77839a;
  font-size: 20rpx;
}

.career-folder-action {
  flex: none;
  color: #a994ff;
  font-size: 21rpx;
  font-weight: 600;
}

.career-children {
  margin-left: 28rpx;
  padding: 6rpx 12rpx 8rpx 18rpx;
  border-left: 2rpx solid #30394b;
}

.career-player {
  min-height: 66rpx;
  padding: 0 14rpx;
  border-bottom: 1rpx solid rgba(40, 49, 66, 0.58);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #d6dbea;
}

.career-player:last-child {
  border-bottom: 0;
}

.career-player.on {
  background: rgba(124, 92, 255, 0.13);
  color: #f2efff;
}

.career-player:active {
  background: rgba(124, 92, 255, 0.22);
}

.career-player-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
}

.career-player-state {
  flex: none;
  margin-left: 18rpx;
  color: #667289;
  font-size: 20rpx;
}

.career-player.on .career-player-state {
  color: #b7a9ff;
  font-weight: 600;
}

.career-empty {
  margin-top: 16rpx;
  padding: 46rpx 20rpx;
  border: 1rpx dashed #30394b;
  border-radius: 14rpx;
  text-align: center;
}

.player-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: -2rpx 0 14rpx;
  font-size: 21rpx;
}

.tool-dot {
  margin: 0 12rpx;
  color: #485166;
}

.manual-badge {
  display: inline-flex;
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  border: 1rpx solid rgba(255, 184, 106, 0.34);
  border-radius: 999rpx;
  background: rgba(139, 83, 24, 0.13);
  color: #ffbf7a;
  font-size: 18rpx;
  font-weight: 700;
}

.save-wrap {
  position: sticky;
  bottom: 0;
  padding: 20rpx 0 30rpx;
}

.save-btn { width: 100%; }
