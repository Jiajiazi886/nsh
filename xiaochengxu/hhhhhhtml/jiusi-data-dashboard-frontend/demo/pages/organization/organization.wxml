<view class="activity-page"><view class="title">组织中心</view><view wx:if="{{loading}}" class="muted">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load" size="mini">重试</button></view><view wx:for="{{organizations}}" wx:key="orgId" class="panel"><view class="section-title">{{item.name}}</view><view class="muted">{{item.orgType==='guild'?'帮会':'俱乐部'}} · {{item.role==='owner'?'管理员':item.role==='assistant'?'助手':'成员'}}</view><button size="mini" bindtap="goActivities">查看我的约战</button><view wx:if="{{item.canManage}}" class="muted">团队配置与临时替补请在网页约战排表操作。保存后网页与小程序同步。</view></view><view wx:if="{{!loading &amp;&amp; !error &amp;&amp; !organizations.length}}" class="panel muted">暂无所属组织</view></view>
