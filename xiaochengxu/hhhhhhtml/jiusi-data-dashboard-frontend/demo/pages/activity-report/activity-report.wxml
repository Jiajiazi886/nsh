<view class="activity-page"><view wx:if="{{loading}}" class="muted">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load" size="mini">重试</button></view><view wx:if="{{report}}" class="panel"><view class="title">{{report.name}}</view><view class="muted">{{report.battleDate}} · {{report.association}}</view><view wx:if="{{!report.players.length}}" class="muted">暂无战报数据</view></view><view wx:for="{{folders}}" wx:key="profession" class="panel"><view data-profession="{{item.profession}}" bindtap="toggle"><text>{{item.expanded?'▾':'▸'}} </text><profession-tag name="{{item.profession}}"/><text> · {{item.players.length}} 人</text></view><block wx:if="{{item.expanded}}"><view wx:for="{{item.players}}" wx:key="name" wx:for-item="player" class="report-player"><view>{{player.name}} · {{player.guildName}}</view><view class="muted">击败 {{player.metrics.kills}} · 助攻 {{player.metrics.assists}} · 资源 {{player.metrics.resources}}</view><view class="muted">人伤 {{player.metrics.dmg_to_players}} · 治疗 {{player.metrics.healing}} · 承伤 {{player.metrics.dmg_taken}}</view></view></block></view></view>
