<view class="activity-page"><view class="title">约战信息</view><view class="tabs"><view class="tab {{kind==='mine'?'active':''}}" data-kind="mine" bindtap="setKind">我的约战</view><view class="tab {{kind==='public'?'active':''}}" data-kind="public" bindtap="setKind">找约战</view><view class="tab {{kind==='history'?'active':''}}" data-kind="history" bindtap="setKind">历史约战</view></view><view wx:if="{{kind==='mine'}}" class="tabs"><view class="tab {{orgType==='guild'?'active':''}}" data-type="guild" bindtap="setOrganization">帮会活动</view><view class="tab {{orgType==='club'?'active':''}}" data-type="club" bindtap="setOrganization">俱乐部活动</view></view><view wx:if="{{kind==='public'}}" class="panel"><view class="picker" bindtap="toggleProfessionOptions">需要的职业：<profession-tag name="{{professionIndex?professions[professionIndex]:''}}"/> ▾</view><view wx:if="{{professionOptionsVisible}}" class="profession-options"><button wx:for="{{professions}}" wx:key="*this" size="mini" data-index="{{index}}" bindtap="selectProfession"><profession-tag name="{{index?item:''}}"/></button></view><checkbox-group bindchange="vacancyChange"><label><checkbox value="vacant" checked="{{vacantOnly}}"/>仅看有空位</label></checkbox-group></view><view class="muted">{{hint}}</view><view wx:if="{{loading}}" class="muted">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="load">重试</button></view><view wx:if="{{!loading &amp;&amp; !error &amp;&amp; !items.length}}" class="panel muted">暂无对应活动</view><view wx:for="{{items}}" wx:key="activityId" class="panel" data-id="{{item.activityId}}" bindtap="open"><view class="section-title">{{item.name}} →</view><view class="muted">{{item.orgName}} · {{item.statusText}}</view><view class="muted">{{item.timeText}}</view><view>{{item.filledSeats}} / {{item.totalSeats}} 人</view><view wx:for="{{item.shortageTags}}" wx:key="profession" wx:for-item="tag" class="shortage"><profession-tag name="{{tag.profession}}"/><text>{{tag.count}}</text></view></view><view class="tabs"><button size="mini" disabled="{{page===1||loading}}" bindtap="previous">上一页</button><view class="muted">第 {{page}} 页</view><button size="mini" disabled="{{!hasNext||loading}}" bindtap="next">下一页</button><button size="mini" bindtap="load">刷新</button></view></view>
