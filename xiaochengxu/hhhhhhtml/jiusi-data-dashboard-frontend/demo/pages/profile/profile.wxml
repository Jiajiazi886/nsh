<view class="activity-page"><view class="title">我的账号</view><view wx:if="{{loading}}" class="muted">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="load">重试</button><button size="mini" bindtap="goLogin">账号登录</button></view><view wx:if="{{user}}" class="panel"><view>{{user.nickName||user.userName}}</view><view class="muted">账号：{{user.userName}}</view><button size="mini" bindtap="logout">退出登录</button></view><player-profile-form/><view class="panel"><view class="section-title">我的组织</view><view wx:for="{{organizations}}" wx:key="orgId" class="card">{{item.name}} · {{item.orgType==='guild'?'帮会':'俱乐部'}} · {{item.role==='owner'?'管理员':item.role==='assistant'?'助手':'成员'}}</view><view wx:if="{{!organizations.length}}" class="muted">暂无所属组织</view></view><view wx:for="{{folders}}" wx:key="profession" class="panel"><view data-profession="{{item.profession}}" bindtap="toggle">{{item.expanded?'▾':'▸'}} <profession-tag name="{{item.profession}}"/> · {{item.players.length}}</view><view wx:if="{{item.expanded}}"><view wx:for="{{item.players}}" wx:key="memberId" class="card">{{item.name}} · ID {{item.memberId}}</view></view></view></view>
