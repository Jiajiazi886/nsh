page {
  background: #080d13;
  color: #f4f1e8;
  font-size: 28rpx;
}

.page-pad {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #121722;
  border: 1rpx solid #283142;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 18rpx 55rpx rgba(0, 0, 0, 0.28);
}

.muted { color: #8f9bb3; }
.small { font-size: 22rpx; }

.section-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #9aa7bc;
  margin: 20rpx 4rpx 14rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #171e2b;
  border: 1rpx solid #283142;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #cdd6ea;
}

.chip.role { color: #d9d1ff; border-color: #3a3357; background: #1b1830; }
.chip.muted { color: #707d94; }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  padding: 16rpx 26rpx;
  font-size: 26rpx;
  line-height: 1.2;
  border: 1rpx solid transparent;
  background: #171e2b;
  color: #eef2ff;
}

.btn-primary { background: #7c5cff; color: #fff; font-weight: 700; }
.btn-ghost { background: transparent; border-color: #283142; }
.btn-danger { background: rgba(255, 93, 115, 0.12); border-color: rgba(255, 93, 115, 0.4); color: #ff93a4; }
.btn-sm { padding: 10rpx 18rpx; font-size: 22rpx; border-radius: 12rpx; }

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-card {
  background: #171e2b;
  border: 1rpx solid #283142;
  border-radius: 16rpx;
  padding: 16rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #8f9bb3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.bar-wrap {
  height: 10rpx;
  border-radius: 999rpx;
  background: #0e131d;
  overflow: hidden;
  margin-top: 12rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7c5cff, #4e8cff);
}

.bar-fill.green { background: linear-gradient(90deg, #20c997, #4e8cff); }
.bar-fill.warn { background: linear-gradient(90deg, #f7b955, #ff5d73); }

.tag-tabs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.tag-tab {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #283142;
  color: #8f9bb3;
  font-size: 23rpx;
  background: #0f141e;
}

.tag-tab.active {
  background: #1a2132;
  color: #d9d1ff;
  border-color: #3a3357;
}

.rank-list { display: block; }

.rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #1c2432;
}

.rank-item:last-child { border-bottom: none; }

.rank-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  background: #171e2b;
  color: #8f9bb3;
  flex-shrink: 0;
}

.rank-no.top1 { background: linear-gradient(135deg, #f7b955, #ff5d73); color: #fff; }
.rank-no.top2 { background: linear-gradient(135deg, #9aa7bc, #5c6b85); color: #fff; }
.rank-no.top3 { background: linear-gradient(135deg, #b07b56, #8a5a36); color: #fff; }

.rank-main { flex: 1; min-width: 0; }
.rank-name { font-size: 27rpx; font-weight: 600; }
.rank-meta { font-size: 21rpx; color: #707d94; margin-top: 4rpx; }
.rank-val { font-size: 27rpx; font-weight: 700; color: #d9d1ff; flex-shrink: 0; }

.empty {
  text-align: center;
  color: #707d94;
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* 综合 Demo：夜战指挥台视觉系统 */
.command-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 72rpx;
  background:
    linear-gradient(145deg, rgba(185, 122, 45, 0.08), transparent 32%),
    linear-gradient(205deg, rgba(31, 181, 168, 0.06), transparent 38%),
    #080d13;
}

.display-title {
  font-family: "STKaiti", "KaiTi", serif;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.command-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 26rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #26313a;
  border-radius: 20rpx;
  background: linear-gradient(145deg, rgba(24, 32, 41, 0.98), rgba(13, 20, 27, 0.98));
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.28);
  animation: command-rise 360ms ease both;
}

.command-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 24rpx;
  width: 72rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #d59745, #6ce0d2);
}

.command-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 4rpx 16rpx;
  color: #c7d0d6;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.command-muted { color: #82909a; }
.command-small { font-size: 22rpx; }

.command-btn,
.command-btn-ghost,
.command-btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
  line-height: 1.2;
}

.command-btn {
  color: #171006;
  font-weight: 700;
  background: linear-gradient(135deg, #f0ba68, #c67a2c);
  box-shadow: 0 12rpx 30rpx rgba(198, 122, 44, 0.2);
}

.command-btn.data-action {
  color: #061817;
  background: linear-gradient(135deg, #7ce9dc, #28aa9f);
  box-shadow: 0 12rpx 30rpx rgba(40, 170, 159, 0.18);
}

.command-btn-ghost {
  color: #cad4da;
  border: 1rpx solid #33414b;
  background: #101820;
}

.command-btn-danger {
  color: #ff9f9f;
  border: 1rpx solid rgba(232, 91, 91, 0.38);
  background: rgba(112, 31, 31, 0.2);
}

.command-input {
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  color: #f3f0e7;
  border: 1rpx solid #30404a;
  border-radius: 14rpx;
  background: #0b1219;
}

.command-label {
  display: block;
  margin-bottom: 10rpx;
  color: #98a5ad;
  font-size: 22rpx;
}

.command-field { margin-bottom: 22rpx; }

.command-pill {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 14rpx;
  border: 1rpx solid #33414b;
  border-radius: 999rpx;
  color: #aeb9c0;
  background: #0d151d;
  font-size: 21rpx;
}

.command-pill.gold { color: #f3bd6f; border-color: rgba(213, 151, 69, 0.4); background: rgba(111, 69, 22, 0.18); }
.command-pill.cyan { color: #73dfd3; border-color: rgba(53, 193, 179, 0.38); background: rgba(18, 91, 85, 0.2); }
.command-pill.red { color: #ff9494; border-color: rgba(232, 91, 91, 0.34); background: rgba(95, 30, 30, 0.2); }

.command-progress {
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #080d12;
}

.command-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #d59745, #f0c982);
}

.analysis-context {
  margin: 0 24rpx 16rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(56, 198, 184, 0.3);
  border-radius: 18rpx;
  background: linear-gradient(120deg, rgba(17, 81, 76, 0.26), rgba(14, 21, 29, 0.96));
}

.analysis-context-title { color: #e7fffb; font-weight: 700; font-size: 26rpx; }
.analysis-context-meta { margin-top: 5rpx; color: #75bdb5; font-size: 21rpx; }

.analysis-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin: 0 24rpx 20rpx;
  padding: 8rpx;
  border: 1rpx solid #26343d;
  border-radius: 18rpx;
  background: #0c131a;
}

.analysis-nav-item {
  padding: 14rpx 6rpx;
  text-align: center;
  color: #788791;
  border-radius: 12rpx;
  font-size: 23rpx;
}

.analysis-nav-item.active {
  color: #071817;
  font-weight: 700;
  background: linear-gradient(135deg, #76dfd3, #34afa4);
}

.command-modal-mask {
  position: fixed;
  z-index: 99;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(1, 5, 8, 0.74);
}

.command-modal {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 30rpx;
  border: 1rpx solid #34434d;
  border-radius: 28rpx 28rpx 18rpx 18rpx;
  background: #111a22;
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.45);
}

@keyframes command-rise {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
