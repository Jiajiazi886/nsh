<navigation-bar title="注册账号" color="#17243a" background="#f4f7fb"></navigation-bar>
<scroll-view class="page-scroll" scroll-y>
  <view class="register-page">
    <view class="panel register-panel">
      <view class="section-title">创建帮会成员账号</view>
      <view class="section-caption">注册成功后自动获得帮会成员角色</view>

      <view class="field">
        <text class="field-label">账号</text>
        <input class="field-input" value="{{username}}" data-field="username" maxlength="30" placeholder="2 至 30 位" bindinput="updateField" />
      </view>

      <view class="field">
        <text class="field-label">密码</text>
        <view class="password-row">
          <input class="field-input password-input" value="{{password}}" data-field="password" password="{{!showPassword}}" maxlength="64" placeholder="至少 6 位" bindinput="updateField" />
          <button class="visibility-button" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</button>
        </view>
      </view>

      <view class="field">
        <text class="field-label">确认密码</text>
        <input class="field-input" value="{{confirmPassword}}" data-field="confirmPassword" password="{{!showPassword}}" maxlength="64" placeholder="再次输入密码" bindinput="updateField" />
      </view>

      <view wx:if="{{captchaEnabled}}" class="field">
        <text class="field-label">验证码</text>
        <view class="captcha-row">
          <input class="field-input captcha-input" value="{{code}}" data-field="code" maxlength="8" placeholder="请输入验证码" bindinput="updateField" />
          <image class="captcha-image" src="{{captchaSrc}}" mode="aspectFill" bindtap="loadAuthState"></image>
        </view>
      </view>

      <button class="primary-button submit-button {{loading || !registerEnabled ? 'button-disabled' : ''}}" loading="{{loading}}" disabled="{{loading || !registerEnabled}}" bindtap="submitRegister">注册</button>
      <view wx:if="{{!registerEnabled}}" class="disabled-notice">系统管理员暂未开放账号注册</view>
    </view>
  </view>
</scroll-view>
