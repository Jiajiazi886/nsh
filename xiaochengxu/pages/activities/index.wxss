.activity-content { max-width: 760rpx; margin: 0 auto; }
.activity-hero { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; border-radius: 16rpx; background: #173f36; color: #fff; }
.hero-label { color: #a8d9cd; font-size: 21rpx; font-weight: 700; }
.hero-title { margin-top: 8rpx; font-size: 38rpx; font-weight: 800; }
.hero-copy { margin-top: 8rpx; color: #d6e8e4; font-size: 22rpx; }
.hero-count { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border: 1rpx solid rgba(255,255,255,.35); border-radius: 50%; font-size: 34rpx; font-weight: 800; }
.overview-grid { margin-top: 20rpx; }
.activity-card { margin-bottom: 14rpx; padding: 22rpx; }
.activity-card-top, .review-card, .invite-input-row, .picker-row { display: flex; align-items: center; }
.activity-card-top, .review-card { justify-content: space-between; gap: 18rpx; }
.activity-name, .review-name { font-size: 27rpx; font-weight: 800; }
.activity-meta, .review-meta { margin-top: 7rpx; color: var(--muted); font-size: 21rpx; }
.invite-code { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); color: var(--violet); font-size: 22rpx; font-weight: 700; }
.create-activity { display: flex; box-sizing: border-box; align-items: center; width: 100%; min-height: 116rpx; margin: 18rpx 0 0; padding: 20rpx 24rpx; border-radius: 16rpx; background: #176b58; color: #fff; text-align: left; }
.create-symbol { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 20rpx; border-radius: 12rpx; background: rgba(255,255,255,.16); font-size: 38rpx; }
.create-title { font-size: 27rpx; font-weight: 800; }
.create-copy { margin-top: 4rpx; color: #d6e8e4; font-size: 21rpx; }
.invite-entry, .schedule-preview { padding: 28rpx; }
.invite-input-row { gap: 12rpx; margin-top: 22rpx; }
.invite-input-row input { flex: 1; }
.invite-input-row button { flex: 0 0 128rpx; margin: 0; }
.review-card { min-height: 88rpx; margin-bottom: 12rpx; padding: 20rpx; }
.review-actions { display: flex; gap: 8rpx; }
.review-actions button { min-width: 86rpx; margin: 0; padding: 0 12rpx; border: 1rpx solid #edc8c8; background: #fff; color: var(--danger); font-size: 21rpx; }
.review-actions .approve-button { border-color: #b9dbd1; color: var(--green); }
.schedule-title { margin-top: 18rpx; font-size: 34rpx; font-weight: 800; }
.schedule-button { margin-top: 24rpx; }
.sheet-mask { position: fixed; z-index: 1200; inset: 0; display: flex; align-items: flex-end; background: rgba(20,30,45,.42); }
.form-sheet { box-sizing: border-box; width: 100%; padding: 32rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 20rpx 20rpx 0 0; background: #fff; }
.sheet-title { margin-bottom: 24rpx; font-size: 32rpx; font-weight: 800; }
.form-sheet .field-input, .form-sheet .field-textarea { margin-top: 14rpx; }
.picker-row { gap: 12rpx; margin-top: 14rpx; }
.picker-row picker { flex: 1; }
.picker-value { height: 82rpx; padding: 0 22rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: #fbfcfe; line-height: 82rpx; }
.error-line { color: var(--danger); }
