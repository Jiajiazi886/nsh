.schedule-content {
  max-width: 760rpx;
  margin: 0 auto;
}

.schedule-header {
  padding: 30rpx;
}

.schedule-name {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.schedule-meta {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.team-block {
  margin-top: 30rpx;
}

.team-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.squad-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.squad-header,
.member-row {
  display: flex;
  align-items: center;
}

.squad-header {
  justify-content: space-between;
}

.squad-name {
  font-weight: 700;
}

.squad-count {
  color: var(--muted);
  font-size: 23rpx;
}

.member-list {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.member-row {
  min-height: 82rpx;
  border-bottom: 1rpx solid var(--line);
}

.member-row:last-child {
  border-bottom: 0;
}

.member-order {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: #edf1f7;
  color: #4d5a70;
  font-size: 21rpx;
  font-weight: 700;
}

.member-copy {
  margin-left: 18rpx;
}

.member-name {
  font-weight: 700;
}

.member-class,
.squad-empty {
  color: var(--muted);
  font-size: 22rpx;
}

.squad-empty {
  padding: 24rpx 0 4rpx;
}

.permission-card {
  padding: 30rpx;
}

.permission-note {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
}
