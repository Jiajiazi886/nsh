<view class="activity-page"><view wx:if="{{loading}}" class="muted">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="load">重试／刷新</button></view>
<block wx:if="{{activity}}"><view class="panel"><view class="title">{{activity.name}}</view><view class="muted">{{activity.orgName}} · {{activity.statusText}}</view><view class="muted">{{activity.timeText}}</view><view>{{activity.remark}}</view><view class="muted">阵容只读，报名／请假不授予编辑权限。</view><view wx:if="{{activity.snapshot}}" class="muted">版本 {{activity.snapshot.version}} · {{activity.savedText}}</view><view wx:if="{{!activity.hasReport}}" class="muted">暂无战报数据</view><button wx:for="{{activity.reportIds}}" wx:key="*this" size="mini" data-id="{{item}}" bindtap="report">查看战报 {{item}}</button><button wx:if="{{activity.canManage &amp;&amp; !activity.isPublic &amp;&amp; activity.snapshot &amp;&amp; activity.state==='open'}}" disabled="{{busy}}" size="mini" bindtap="publish">发布公开</button><button wx:if="{{activity.canManage &amp;&amp; activity.snapshot &amp;&amp; activity.state==='open'}}" disabled="{{busy}}" size="mini" bindtap="end">结束活动</button><view wx:if="{{activity.canManage}}" class="muted">排表请在网页“帮会管理 → 约战排表”配置；保存后本页同步读取。</view></view>
<view wx:if="{{activity.state==='open'}}" class="panel"><view>本人绑定角色</view><view wx:if="{{profiles.length}}" class="picker" bindtap="toggleProfileOptions">{{profiles[profileIndex].name}} · <profession-tag name="{{profiles[profileIndex].profession}}"/> ▾</view><view wx:if="{{profileChoiceVisible}}"><view wx:for="{{profileFolders}}" wx:key="profession" wx:for-item="folder" class="card"><view data-profession="{{folder.profession}}" bindtap="toggleProfileFolder">{{folder.expanded?'▾':'▸'}} <profession-tag name="{{folder.profession}}"/> · {{folder.players.length}}</view><view wx:if="{{folder.expanded}}"><button wx:for="{{folder.players}}" wx:for-item="candidate" wx:key="memberId" size="mini" data-index="{{candidate.index}}" bindtap="selectProfile">{{candidate.name}}</button></view></view></view><view wx:if="{{!profiles.length}}" class="muted">暂无有效绑定角色，请先完善成员资料。</view><view wx:if="{{profileError}}" class="error">{{profileError}}</view></view>
<view wx:for="{{teams}}" wx:for-item="team" wx:key="id" class="panel"><view class="section-title">{{team.name}}</view><view wx:for="{{team.squads}}" wx:for-item="squad" wx:key="id" class="squad"><view>{{squad.name}} · {{squad.filled}} / 6</view><view class="seats"><view wx:for="{{squad.seats}}" wx:for-item="seat" wx:key="position" class="seat {{!seat.player?'seat-empty':''}}"><view class="muted">位置 {{seat.position}}</view><text class="profession" style="{{seat.requiredStyle}}">{{seat.requiredProfession||'不限职业'}}</text><block wx:if="{{seat.player}}"><view class="player-name">{{seat.player.name}}{{seat.player.isTemporary?'（临时）':''}}</view><text class="profession" style="background:{{seat.color}};color:{{seat.textColor}}">{{seat.player.profession}}</text><button wx:if="{{seat.isMine &amp;&amp; activity.state==='open'}}" size="mini" disabled="{{busy}}" data-member="{{seat.player.memberId}}" bindtap="leave">请假</button></block><block wx:else><view class="empty-label">空缺</view><button wx:if="{{activity.canSignup}}" size="mini" disabled="{{busy||!profiles.length}}" data-squad="{{squad.id}}" data-position="{{seat.position}}" bindtap="signup">报名</button></block></view></view></view></view><view wx:if="{{!teams.length}}" class="panel muted">管理员尚未保存阵容</view></block></view>
