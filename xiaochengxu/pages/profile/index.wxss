.profile-content {
  max-width: 760rpx;
  margin: 0 auto;
}

.identity-card,
.detail-row,
.role-list {
  display: flex;
  align-items: center;
}

.identity-card {
  padding: 30rpx;
  border-radius: 16rpx;
  background: #29364a;
  color: #ffffff;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: var(--green);
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
}

.identity-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.identity-name {
  font-size: 34rpx;
  font-weight: 800;
}

.identity-account {
  margin-top: 6rpx;
  color: #c9d1df;
  font-size: 23rpx;
}

.identity-role {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #176b58;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.detail-card {
  margin-top: 24rpx;
  padding: 0 28rpx;
}

.detail-row {
  justify-content: space-between;
  min-height: 94rpx;
  border-bottom: 1rpx solid var(--line);
  color: #3d4b62;
  font-size: 25rpx;
}

.detail-row:last-child {
  border-bottom: 0;
}

.role-list {
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  max-width: 420rpx;
}

.role-item {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #f0edfb;
  color: var(--violet);
  font-size: 21rpx;
}

.detail-value {
  color: var(--ink);
  font-weight: 700;
}

.active-value {
  color: var(--green);
}

.logout-button {
  margin-top: 30rpx;
}

.profile-form {
  padding: 28rpx;
}

.save-profile {
  margin-top: 24rpx;
}

.usage-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.usage-card {
  min-width: 0;
  padding: 26rpx;
  border: 1rpx solid #c8ded7;
  border-radius: 16rpx;
  background: #edf7f3;
}

.vip-card {
  border-color: #e7d6a7;
  background: #fff8e9;
}

.usage-label {
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 700;
}

.usage-value {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.usage-copy {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.usage-note {
  margin-top: 18rpx;
}

.endpoint-row {
  align-items: flex-start;
  padding: 22rpx 0;
}

.endpoint-value {
  max-width: 430rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}
/* Profile remains plain and readable. */
.identity-card{background:#fff;color:#253044;border:1rpx solid #dce0e6;padding:20rpx;border-radius:6rpx}
.identity-account{color:#687386}.avatar{background:#edf3fc;color:#245db2;width:70rpx;height:70rpx;font-size:30rpx;border-radius:6rpx}.identity-role{background:#edf3fc;color:#245db2;border-radius:4rpx}
