.roster-content {
  max-width: 760rpx;
  margin: 0 auto;
}

.roster-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 4rpx 26rpx;
}

.workspace-kicker {
  color: var(--green);
  font-size: 21rpx;
  font-weight: 800;
}

.roster-title {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.roster-count {
  color: var(--violet);
  font-size: 48rpx;
  font-weight: 800;
}

.search-row {
  margin-bottom: 24rpx;
}

.search-input {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: #ffffff;
}

.member-card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.member-sequence {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 10rpx;
  background: #edf7f3;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 800;
}

.member-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.member-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-meta,
.member-remark {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.member-remark {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  flex: 0 0 auto;
  margin-left: 18rpx;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 700;
}

.permission-card {
  padding: 28rpx;
}

.permission-note {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}
