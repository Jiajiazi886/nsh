.guild-content { max-width: 760rpx; margin: 0 auto; }
.guild-banner { display: flex; align-items: center; padding: 28rpx; border: 1rpx solid #cedbd7; border-radius: 16rpx; background: #eef6f3; }
.guild-mark { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border: 2rpx solid #176b58; border-radius: 50%; color: var(--green); font-size: 36rpx; font-weight: 800; }
.guild-banner-copy { flex: 1; min-width: 0; margin-left: 20rpx; }
.guild-banner-title { font-size: 34rpx; font-weight: 800; }
.guild-banner-meta { margin-top: 6rpx; color: var(--muted); font-size: 22rpx; }
.manager-tag { padding: 8rpx 14rpx; border-radius: 10rpx; background: #176b58; color: #fff; font-size: 20rpx; font-weight: 700; }
.guild-grid { margin-top: 20rpx; }
.class-row { display: grid; grid-template-columns: 104rpx minmax(0, 1fr) 50rpx; align-items: center; gap: 14rpx; min-height: 58rpx; }
.class-name, .class-count { font-size: 22rpx; font-weight: 700; }
.class-count { color: var(--muted); text-align: right; }
.class-track { overflow: hidden; height: 12rpx; border-radius: 6rpx; background: #e7ebf0; }
.class-fill { height: 100%; border-radius: 6rpx; background: #176b58; }
.member-toolbar, .member-row, .application-top, .field-pair { display: flex; align-items: center; }
.member-toolbar { gap: 12rpx; margin-bottom: 16rpx; }
.member-toolbar input { flex: 1; }
.add-button { flex: 0 0 120rpx; margin: 0; }
.member-row { min-height: 102rpx; border-bottom: 1rpx solid var(--line); }
.member-index { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 10rpx; background: #edf7f3; color: var(--green); font-size: 20rpx; font-weight: 800; }
.member-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.member-name { font-size: 27rpx; font-weight: 800; }
.member-meta { margin-top: 5rpx; color: var(--muted); font-size: 21rpx; }
.member-role { color: var(--green); font-size: 21rpx; font-weight: 700; }
.application-card { margin-bottom: 14rpx; padding: 22rpx; }
.application-top { justify-content: space-between; gap: 18rpx; }
.application-remark { margin-top: 14rpx; padding: 14rpx; border-radius: 10rpx; background: #f6f8fa; color: var(--muted); font-size: 22rpx; }
.settings-card { padding: 28rpx; }
.save-button, .join-button { margin-top: 24rpx; }
.error-line { color: var(--danger); }
.sheet-mask { position: fixed; z-index: 1200; inset: 0; display: flex; align-items: flex-end; background: rgba(20,30,45,.42); }
.form-sheet { box-sizing: border-box; width: 100%; padding: 32rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 20rpx 20rpx 0 0; background: #fff; }
.sheet-title { margin-bottom: 24rpx; font-size: 32rpx; font-weight: 800; }
.form-sheet .field-input, .form-sheet .field-textarea { margin-top: 14rpx; }
.field-pair { gap: 12rpx; }
.field-pair input { flex: 1; min-width: 0; }
