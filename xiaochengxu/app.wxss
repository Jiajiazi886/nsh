page {
  --ink: #17243a;
  --muted: #637089;
  --line: #dce3ec;
  --surface: #ffffff;
  --canvas: #f4f7fb;
  --green: #176b58;
  --violet: #6541d8;
  --gold: #d5a21e;
  --danger: #c94444;
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

button,
input,
textarea {
  font: inherit;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

.page-scroll {
  height: 100vh;
}

.page-content {
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(152rpx + env(safe-area-inset-bottom));
}

.page-kicker {
  color: var(--green);
  font-size: 21rpx;
  font-weight: 800;
}

.page-title {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 800;
}

.segmented-control {
  display: flex;
  gap: 8rpx;
  box-sizing: border-box;
  width: 100%;
  margin: 22rpx 0;
  padding: 7rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: #ffffff;
}

.segment-button {
  flex: 1;
  min-width: 0;
  min-height: 68rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 10rpx;
  background: transparent;
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.segment-active {
  background: #176b58;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(23, 107, 88, 0.17);
}

.compact-card {
  padding: 24rpx;
}

.data-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--line);
}

.data-cell {
  min-width: 0;
  padding: 22rpx;
  background: #ffffff;
}

.data-value {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 800;
}

.data-label {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 0 16rpx;
}

.section-heading-title {
  font-size: 29rpx;
  font-weight: 800;
}

.section-heading-meta {
  color: var(--muted);
  font-size: 21rpx;
}

.inline-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.inline-actions button {
  flex: 1;
}

.panel {
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.section-title {
  margin: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.section-caption {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #3d4b62;
  font-size: 24rpx;
  font-weight: 600;
}

.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: #fbfcfe;
  color: var(--ink);
}

.field-input {
  height: 84rpx;
  padding: 0 24rpx;
}

.field-textarea {
  min-height: 144rpx;
  padding: 20rpx 24rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 84rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  background: var(--violet);
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid var(--line);
  background: #ffffff;
  color: var(--ink);
}

.danger-button {
  border: 1rpx solid #efcaca;
  background: #fff8f8;
  color: var(--danger);
}

.button-disabled {
  opacity: 0.55;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #edf7f3;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 700;
}

.empty-state {
  padding: 56rpx 24rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.6;
}
